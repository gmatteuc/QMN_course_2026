# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Conda / venv
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Data-prep working directory: only the exploration notebooks and the IBL build
# script are tracked. Reference material, the EEG build scripts and the
# regenerable download caches stay out of the repository.
data_prep/*
!data_prep/build_ibl_dataset.py
!data_prep/explore_ibl.ipynb
!data_prep/explore_eeg.ipynb
!data_prep/explore_n170.ipynb

# Figures written by the notebooks themselves when they are run (the plotting
# section saves one on purpose). The images we ship live in notebooks/assets/.
notebooks/*.png

# Raw EEG source files (~100 MB of .mat downloaded from Zenodo). The packaged
# notebooks/data/alphawaves.npz is what the course uses; re-download the raw
# release only if the package has to be rebuilt.
eeg_datasets/
