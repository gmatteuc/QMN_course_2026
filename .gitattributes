*.ipynb filter=nbstripout
*.zpln filter=nbstripout
*.ipynb diff=ipynb

# The exploration notebooks are committed WITH their outputs, so their plots are
# viewable on GitHub without running them: exempt them from nbstripout.
data_prep/explore_ibl.ipynb -filter
data_prep/explore_eeg.ipynb -filter
data_prep/explore_n170.ipynb -filter

# Notebook drafts under review are committed WITH their outputs, so co-TAs can
# read them on GitHub without running them. Once a draft is promoted to
# notebooks/ as a student notebook it goes back to being stripped like the rest.
notebooks/drafts/*.ipynb -filter
